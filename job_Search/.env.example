# Copy to .env for LOCAL runs (never commit the real .env — it's gitignored).
# On GitHub these are set as repository Secrets, not in a file.

# --- Adzuna (free key at https://developer.adzuna.com/) ---
ADZUNA_APP_ID=your_app_id
ADZUNA_APP_KEY=your_app_key
ADZUNA_COUNTRY=us

# --- JSearch (big-board coverage: LinkedIn / Indeed / Glassdoor via Google for Jobs) ---
# Subscribe (free Basic tier) at https://rapidapi.com/OpenWeb-Ninja/api/jsearch
# then copy your RapidAPI application key here. If unset, the jsearch source is skipped.
RAPIDAPI_KEY=your_rapidapi_key

# --- Sponsor-list auto-refresh (build_sponsors.py) ---
# Direct .csv link from the USCIS H-1B Employer Data Hub Files page:
# https://www.uscis.gov/tools/reports-and-studies/h-1b-employer-data-hub-files
# If unset, sponsors.txt stays as the shipped starter list. See SETUP_KEYS.md.
# SPONSORS_SOURCE_URL=
# SPONSORS_TTL_HOURS=20

# --- Gmail digest ---
# GMAIL_APP_PASSWORD is a 16-char Google "App Password" (needs 2FA on), NOT
# your normal Gmail password. Google Account > Security > App passwords.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
# DIGEST_TO=someone_else@example.com   # optional; defaults to GMAIL_ADDRESS

# --- Search defaults (CLI flags override these) ---
JOB_QUERY=data engineer
REMOTE_ONLY=true
EXCLUDE_NO_SPONSORSHIP=true
JOB_LOCATION=United States
# MIN_SALARY=160000        # optional salary floor (off by default)
# REQUIRE_SALARY=true      # with MIN_SALARY, also drop jobs that list NO salary
WINDOW_MIN=60
SEEN_FILE=state/seen.json
# Default sources exclude the company ATS boards. To include them, or run a subset:
# SOURCES=remotive,arbeitnow,adzuna,jobicy,muse,remoteok,jsearch,greenhouse,lever,ashby
# MUSE_API_KEY=optional_raises_muse_rate_limit
