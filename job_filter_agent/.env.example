# Copy to .env for local runs (gitignored). On GitHub, set these as Secrets.

# --- Scoring (required) ---
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional: pin a model. Defaults to claude-haiku-4-5-20251001 (cheap Haiku 4.5,
# good enough for scoring). For sharper judgment: claude-sonnet-4-5-20250929.
# List your account's models: curl https://api.anthropic.com/v1/models
#   -H "x-api-key: $KEY" -H "anthropic-version: 2023-06-01"
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Email digest (same Gmail app password as the fetcher) ---
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
# DIGEST_TO=someone_else@example.com

# --- Behaviour (CLI flags override) ---
MIN_SCORE=70
MAX_CALLS=60
# STAFFING_FILE=staffing_blocklist.txt   # firms to drop (direct employers only)
# JOBS_FILE=../job_Search/jobs.json
# RESUME_FILE=resume.md
# SPONSORS_FILE=../job_Search/sponsors.txt
